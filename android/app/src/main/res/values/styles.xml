<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown briefly while Flutter initializes. Matches the app's white/
         off-white light background so there's no color flash on launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Used by Flutter after the first frame is drawn; keep it as a plain
         theme with no splash drawable so the app's own UI takes over. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
