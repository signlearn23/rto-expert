# Standard Gradle wrapper shell launcher. The accompanying
# gradle-wrapper.jar is generated in CI (see .github/workflows/build.yml)
# rather than committed as a binary, since it can't be authored as text.
# If running locally, first run: gradle wrapper --gradle-version 8.11
##############################################################################

PRG="$0"
APP_HOME=$(cd "$(dirname "$PRG")" >/dev/null && pwd -P)
APP_NAME="Gradle"
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

warn () { echo "$*" ; }
die () { echo; echo "$*"; echo; exit 1; }

if [ -z "$JAVA_HOME" ] ; then
    JAVACMD="java"
    command -v java >/dev/null 2>&1 || die "JAVA_HOME is not set and no 'java' command could be found."
else
    JAVACMD="$JAVA_HOME/bin/java"
    [ -x "$JAVACMD" ] || die "JAVA_HOME is set to an invalid directory: $JAVA_HOME"
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=$APP_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
