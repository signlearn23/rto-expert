# This file is normally auto-generated by the `flutter` CLI itself
# (during `flutter pub get` / `flutter build`) — it writes `sdk.dir` and
# `flutter.sdk` to point at your installed SDKs automatically. You should
# not need to create this by hand in most cases, on CI or locally.
#
# This example is kept only as a reference for what the generated file
# looks like, and as a fallback if your Flutter install ever doesn't
# auto-populate it. The real `local.properties` is gitignored — never
# commit it, since its paths are specific to your machine.

sdk.dir=/path/to/your/Android/sdk
flutter.sdk=/path/to/your/flutter
flutter.versionName=1.0.0
flutter.versionCode=1
